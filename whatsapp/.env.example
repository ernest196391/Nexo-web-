# Copia este archivo a .env y rellénalo. .env nunca se sube al repositorio.

# --- Quién eres ---
NEGOCIO=NEXO
WEB=https://nexo-plan-veci.vercel.app
# Cuando hace falta una persona, el bot te avisa en tu propio chat de WhatsApp
# (el de "mensajearme a mí mismo"). No manda mensajes a ningún otro número.

# --- Seguridad: lo más importante del archivo ---
# Números que el bot puede responder, separados por comas. Sin + ni espacios.
# Mientras esto tenga algo, el bot IGNORA a todos los demás.
# Déjalo vacío SOLO cuando ya confíes en el bot: entonces responde a cualquiera.
LISTA_BLANCA=5354056173

# --- Ritmo (frena el riesgo de bloqueo) ---
ESPERA_MIN_MS=2500
ESPERA_MAX_MS=6000
TOPE_CONTACTO_HORA=12
TOPE_GLOBAL_HORA=60
# Tras pasar a una persona, el bot se calla con ese contacto estos minutos.
SILENCIO_MIN=30

# --- IA (opcional) ---
# Sin clave el bot sigue funcionando: responde con las reglas y, si no entiende,
# te pasa la conversación. Con clave entiende lo que le escriban en cualquier forma.
ANTHROPIC_API_KEY=
CLAUDE_MODELO=claude-opus-5
