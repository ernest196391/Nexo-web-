# Copia a .env y rellena. .env nunca se sube al repositorio.
# Los negocios NO van aquí: van en la base de datos (npm run gestionar).

# --- Seguridad: lo más importante del archivo ---
# Números que el bot puede responder, separados por comas. Sin + ni espacios.
# Mientras tenga algo, IGNORA a todos los demás. Déjalo vacío solo cuando
# ya confíes en el bot: entonces responde a cualquiera que escriba.
LISTA_BLANCA=5354056173

# --- Ritmo (frena el riesgo de bloqueo) ---
ESPERA_MIN_MS=2500
ESPERA_MAX_MS=6000
TOPE_CONTACTO_HORA=12
TOPE_GLOBAL_HORA=60
# Minutos que el bot se calla en un chat después de que respondas tú.
SILENCIO_MIN=30

# --- IA (opcional: sin esto el bot funciona igual, con lo que te ha aprendido) ---
# Formato OpenAI. Vale OpenAI, OpenRouter, LM Studio, llama.cpp… cualquiera
# que hable /chat/completions. Cambias la URL y ya.
IA_BASE_URL=https://api.openai.com/v1
IA_CLAVE=
# Corre `npm run modelos` para ver cuáles admite tu clave, y pon uno aquí.
IA_MODELO=
IA_ESPERA_MS=20000

# --- Dónde vive la base de datos ---
BASE_DATOS=datos/nexo.db
